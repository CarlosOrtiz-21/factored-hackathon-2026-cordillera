# Copy to .env.local. NEXT_PUBLIC_* values are baked into the static bundle at build time,
# so never put secrets here.

# FastAPI backend (its FRONTEND_ORIGIN must be this site's origin, for CORS).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: demo customer ids shown as quick picks on the login screen (comma-separated).
# Pick active customers from data/bank.db. Blocking a card in the demo changes their state.
NEXT_PUBLIC_DEMO_CUSTOMERS=CLI-VVPNBU14MLFY,CLI-S4QD77UG44C2,CLI-0211YH7YPK0Y
