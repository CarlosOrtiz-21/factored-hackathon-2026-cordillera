# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Anthropic (or run `ant auth login` and leave this empty)
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (Console -> Settings -> Workspaces):
# ANTHROPIC_WORKSPACE_ID=

# Model per agent (defaults shown). All-Haiku ablation: set all four to claude-haiku-4-5.
# Supported: claude-haiku-4-5, claude-sonnet-5, claude-opus-5 (see src/cardagent/llm/profiles.py)
# TRIAGE_MODEL=claude-haiku-4-5
# EXECUTOR_MODEL=claude-sonnet-5
# RAG_MODEL=claude-sonnet-5
# CRITIC_MODEL=claude-sonnet-5

# Dataset access (read-only S3; values are in the data-dictionary PDF)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2

# Optional overrides
# PII_SCORE_THRESHOLD=0.5
# APPROVAL_TTL_MINUTES=10
